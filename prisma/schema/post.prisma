model Post {
    id         String     @id @default(uuid())
    title      String     @db.VarChar(255)
    content    String
    thumbnail  String?
    isFeatured Boolean    @default(false)
    status     PostStatus @default(Published)
    tags       String[]
    views      Int        @default(0)
    author_id  String //manage better auth later  
    createdAt  DateTime   @default(now())
    updatedAt  DateTime   @updatedAt
    commnets   Commnet[]

    @@index([author_id])
    @@map("posts")
}

enum PostStatus {
    Draft
    Published
    Archived
}
